# Backend origin (no trailing slash, no /api suffix).
# Set this in the Vercel dashboard (Settings > Environment Variables) as
# API_URL (a plain, non-public config var — Vite exposes API_* via envPrefix),
# or in frontend/.env for local runs.
#
# Leave it unset for local development — the app then uses Vite's dev proxy
# (see vite.config.js) so you only need the backend running on :8000.
API_URL=https://your-backend-domain.com